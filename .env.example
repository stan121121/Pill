BOT_TOKEN=
COINMARKETCAP_API_KEY=

# Monad: адрес пула Aave v3 (AaveV3Monad.POOL из адресной книги Aave, search.onaave.com)
POOL_MONAD=

# Необязательно:
# DB_PATH=/data/monitor.db       # SQLite (на Railway смонтируйте Volume)
# CHAINS=ethereum,arbitrum,base  # ограничить набор сетей
# RPC_ETHEREUM=https://...       # свой RPC (через запятую можно несколько); аналогично RPC_<СЕТЬ>
# POOL_<СЕТЬ>=0x...              # переопределить адрес пула
# EXTRA_CHAINS=[{"key":"mynet","name":"MyNet","chain_id":1234,"pool":"0x...","rpc":"https://..."}]
# CHAIN_INTERVAL=180             # сек между проверками кошельков
# FULL_SCAN_MIN=30               # как часто обходить ВСЕ сети (между обходами только активные)
# CHECK_INTERVAL=300             # сек между проверками расчётных позиций (CMC)
# PRICE_TTL=240
# MAX_WALLETS=5
# MAX_POSITIONS=5
# REMIND_WARN_MIN=60
# REMIND_CRIT_MIN=15
